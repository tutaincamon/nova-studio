{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/camisetas",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "nova-studio-peach.vercel.app"
        }
      ],
      "destination": "https://www.novasupply.es/$1",
      "permanent": false
    }
  ]
}
